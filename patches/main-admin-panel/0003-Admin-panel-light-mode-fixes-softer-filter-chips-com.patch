 src/components/admin/NovaTab.jsx | 2 +-
 src/pages/AdminPage.jsx          | 8 ++++----
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/components/admin/AdminUI.jsx b/src/components/admin/AdminUI.jsx
index 7f5f607..5f53497 100644
--- a/src/components/admin/AdminUI.jsx
+++ b/src/components/admin/AdminUI.jsx
@@ -159,7 +159,7 @@ export function AdminShell({ nav, activeIndex, onSelect, title, role, onLogout,
