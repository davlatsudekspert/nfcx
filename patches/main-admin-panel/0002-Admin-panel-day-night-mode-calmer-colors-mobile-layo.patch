+/* Ko'prik: themes.css dagi :root ko'prigi qiymatlarni :root da hisoblab
+   bo'lgan — admin ichida ularni shu rejim ranglaridan QAYTA hisoblaymiz. */
+.admin-root {
+  --color-page-bg: var(--bg-primary);
+  --root-bg: var(--bg-primary);
+  --color-base-100: var(--surface);
+  --color-base-200: var(--surface-elevated);
+  --color-base-300: var(--surface-raised);
+  --color-base-content: var(--text-primary);
+  --color-primary: var(--accent-primary);
+  --color-primary-content: var(--accent-ink);
+  --color-secondary: var(--accent-secondary);
+  --color-secondary-content: var(--accent-ink);
+  --color-accent: var(--accent-primary);
+  --color-accent-content: var(--accent-ink);
+  --color-neutral: var(--surface-elevated);
+  --color-neutral-content: var(--text-primary);
+  --color-info: var(--info);
+  --color-info-content: var(--accent-ink);
+  --color-success: var(--success);
+  --color-success-content: #ffffff;
+  --color-warning: var(--warning);
+  --color-warning-content: var(--accent-ink);
+  --color-error: var(--danger);
+  --color-error-content: #ffffff;
+
+  --vz-gold: var(--accent-primary);
+  --vz-gold-2: var(--accent-secondary);
+  --vz-gold-3: var(--accent-deep);
+  --vz-gold-ink: var(--accent-ink);
+  --vz-bg: var(--bg-primary);
+  --vz-bg-2: var(--bg-secondary);
+  --vz-bg-a: var(--bg-gradient-a);
+  --vz-bg-b: var(--bg-gradient-b);
+  --vz-card: var(--surface);
+  --vz-card-2: var(--surface-elevated);
+  --vz-line: var(--border);
+  --vz-ink: var(--text-primary);
+  --vz-ink-2: var(--text-secondary);
+  --vz-ink-3: var(--text-muted);
+  --vz-ink-dim: var(--text-secondary);
+  --vz-ink-faint: var(--text-faint);
+  --vz-accent: var(--accent-primary);
+  --vz-danger: var(--danger);
+  --vz-link: var(--link);
+  --vz-shadow: var(--shadow);
+  --vz-pill: var(--pill-bg);
+  --accent-text: var(--accent-secondary);
+  --accent-a08: color-mix(in srgb, var(--accent-primary) 8%, transparent);
+  --accent-a14: color-mix(in srgb, var(--accent-primary) 14%, transparent);
+  --accent-a22: color-mix(in srgb, var(--accent-primary) 22%, transparent);
+  --accent-a25: color-mix(in srgb, var(--accent-primary) 25%, transparent);
+  --accent-a45: color-mix(in srgb, var(--accent-primary) 45%, transparent);
+  --shadow-cast: color-mix(in srgb, var(--shade-base) 55%, transparent);
+
+  background: var(--bg-primary);
+  color: var(--text-primary);
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+
+/* Kartalar tekis — gradient va og'ir soya ko'zni chalg'itadi. */
+.admin-root .vz-card { background: var(--surface); }
+.admin-root[data-admin-theme="light"] .vz-card { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), var(--shadow); }
+.admin-root .vz-badge--info { color: var(--admin-info-text); }
+/* Oltin tugmaning yorqin nuri — faqat biroz. */
+.admin-root .btn-gold { box-shadow: 0 6px 16px -10px color-mix(in srgb, var(--accent-primary) 55%, transparent); }
+/* Yorug' rejimda oq "hover" ko'rinmaydi — kulrang soya bilan. */
+.admin-root[data-admin-theme="light"] .hover\:bg-white\/\[0\.03\]:hover { background-color: rgba(0, 0, 0, 0.03); }
