{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Mavjud production Worker nomi (Cloudflare Dashboard'da shunday
  // ko'rinadi) — bu maydon Worker'ning IDENTITY'sini belgilaydi, D1/R2
  // bog'lanish nomlariga bog'liq emas.
  "name": "nfcstore-api",
  // Worker skripti — `npm run build` (scripts/prepare-sites-build.mjs)
  // hosting/worker.js'ni shu yerga nusxalaydi. Avval bu maydon yo'q edi,
  // shu sabab `wrangler deploy` faqat statik fayllarni joylardi —
  // hosting/worker.js'dagi /api/* logikasi HECH QACHON ishga tushmasdi.
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-31",
  // Worker loglari. Dashboard'dagi tugmachani yoqish YETARLI EMAS: bu
  // fayl deploy'da sozlamalarning yagona manbai bo'lgani uchun, bu yerda
  // yozilmasa har bir deploy loglarni QAYTA O'CHIRIB qo'yadi (Cloudflare
  // paneli ham aynan shundan ogohlantiradi).
  //
  // 2026-09-07: Payme ulanishida -32504 xatosini soatlab ko'r-ko'rona
  // qidirishga to'g'ri keldi, chunki loglar o'chiq edi va serverimiz
  // Payme'ga nima javob berayotganini ko'rishning iloji yo'q edi.
  // Endi doimiy yoqilgan. Loglarga maxfiy qiymatlar yozilmaydi —
  // paymeAuthReasonD1() faqat rad etish sababini va uzunliklarni beradi.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // wrangler'ning standart xatti-harakati: bu fayl "vars" uchun yagona
  // haqiqat manbai hisoblanadi va HAR BIR deploy'da Dashboard'da qo'lda
  // qo'yilgan, lekin shu yerda yozilmagan istalgan boshqa vars'ni
  // O'CHIRIB TASHLAYDI. `keep_vars: true` buni oldini oladi — Dashboard'da
  // allaqachon mavjud har qanday boshqa o'zgaruvchi (masalan kelajakda
  // qo'shilishi mumkin bo'lgan TELEGRAM_BOT_USERNAME kabi) tegilmay qoladi;
  // pastdagi PAYMENTS_ENABLED esa aniq shu qiymat bilan qo'yiladi/yangilanadi.
  // DIQQAT: PAYME_KEY va PAYME_MERCHANT_ID hech qachon shu faylda yozilmaydi
  // — ular Cloudflare secret sifatida Dashboard'da alohida saqlanadi va
  // `keep_vars`dan qat'i nazar `wrangler deploy` ularga umuman tegmaydi
  // (secretlar "vars" reconciliation'iga kirmaydi).
  "keep_vars": true,
  "assets": {
    // dist/client — statik fayllarning "toza" nusxasi (dist/ ildizida
    // esa Express serveri o'qiydigan asl Vite chiqishi + dist/client,
    // dist/server pastki papkalari ham bor — ularni Cloudflare'ga
    // statik aktiv sifatida yubormaslik uchun aynan dist/client tanlangan).
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  // Mavjud production D1/R2 resurslari — hosting/worker.js env.DB va
  // env.UPLOADS orqali ishlatadi. Bular AVVAL bu faylda yozilmagan edi
  // (Dashboard orqali qo'lda ulangan bo'lgan) — shu sababdan `wrangler
  // deploy` ularni Worker'dan OLIB TASHLASH xavfi bor edi. Endi aniq
  // yozilgani uchun deploy ularni saqlab qoladi. Yangi resurs
  // YARATILMAYDI — bular allaqachon mavjud, real production D1/R2.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "DB",
      "database_id": "01eed0bb-eb3a-41b1-ab1f-ea14cf001dd8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "nfcstore-uploads"
    }
  ],
  // Payme SANDBOX'ni yoqish uchun foydalanuvchining aniq ruxsati bilan
  // qo'shildi (2026-09). PAYME_MERCHANT_ID va PAYME_KEY (Cloudflare
  // Dashboard'da secret sifatida ALLAQACHON mavjud) bilan birga
  // hosting/worker.js'dagi paymentsEnabledD1() shartini rost qiladi —
  // kod aynan `env.PAYMENTS_ENABLED === 'true'` (kichik harf, satr) ni
  // kutadi. Bu maxfiy qiymat EMAS — oddiy feature-flag, shuning uchun
  // repo'da ochiq saqlanishi xavfsiz. Real (production) Payme kalitlariga
  // o'tish yoki to'lovni yoqish/o'chirish qarori BU FAYLDA emas — u to'liq
  // Dashboard'dagi PAYME_MERCHANT_ID/PAYME_KEY qiymatlariga bog'liq.
  //
  // PAYME_SANDBOX — Payme test (sandbox) rejimi. Bu MAXFIY EMAS, oddiy
  // feature-flag: u FAQAT interfeysdagi "TEST REJIMI" va "Real pul
  // yechilmaydi" izohlarini ko'rsatadi. To'lov mantig'i, Merchant API
  // metodlari va idempotentlik unga bog'liq emas.
  // Ertaga real Merchant ma'lumotlari qo'yilganda shu yerda "false" qilinsa
  // (yoki Dashboard'da), o'sha ikki izoh AVTOMATIK yo'qoladi; Payme logosi
  // va to'lov tugmasi joyida qoladi.
  //
  // PAYME_CHECKOUT_DOMAIN — sandbox checkout domeni (https://test.paycom.uz).
  // Payme tugmasi bosilganda foydalanuvchi aynan shu domendagi sandbox
  // to'lov sahifasiga o'tadi. Production'ga o'tishda bu qiymat
  // checkout.paycom.uz ga almashtiriladi (yoki butunlay olib tashlanadi —
  // kod standart sifatida checkout.paycom.uz ni ishlatadi).
  //
  // Merchant API endpoint (Payme kabinetida ko'rsatiladi):
  //   https://nfcstore.uz/api/pay/payme
  // 2026-09-07: Payme kassa FAOL — ishlab chiqarishga o'tildi.
  // Sandbox bayrog'i o'chirildi ("TEST REJIMI" va "Real pul yechilmaydi"
  // izohlari avtomatik yo'qoladi) va checkout domeni haqiqiysiga
  // almashtirildi. Bu ikkovi BIRGA o'zgarishi shart: biri sinovda,
  // ikkinchisi ishlab chiqarishda qolsa, mijoz noto'g'ri sahifaga tushadi.
  "vars": {
    "PAYMENTS_ENABLED": "true",
    "PAYME_SANDBOX": "false",
    "PAYME_CHECKOUT_DOMAIN": "checkout.paycom.uz"
  }
}
