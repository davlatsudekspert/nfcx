<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NFCSTORE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>nfcstore_nova</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- NFC — iOS.

	     Bu matn kartani tegizish oynasida KO'RINADI. Kalit
	     bo'lmasa CoreNFC sessiyasi UMUMAN ochilmaydi (ilova
	     darhol yiqiladi), shuning uchun u Android'dagi
	     `android.permission.NFC` ning aynan muqobili.

	     DIQQAT — BU YETARLI EMAS. iOS'da NFC ishlashi uchun
	     yana ikkita narsa kerak:
	       1. `Runner.entitlements` (faqat `TAG`) loyihaga
	          ulangan bo'lishi — `CODE_SIGN_ENTITLEMENTS`, bajarilgan;
	       2. Apple Developer hisobida shu imkoniyat yoqilgan
	          provisioning profil — hisob ochilgach.
	     Haqiqiy iPhone'da NFC hali SINALMAGAN —
	     `IOS_RELEASE_CHECKLIST.md` ga qarang. -->
	<!-- RUXSAT MATNLARI — IKKI TILDA, BITTA QATORDA (App Store 5.1.1(ii)).
	     Ilova interfeysi uz/ru/en, tekshiruvchi esa odatda inglizcha
	     o'qiydi: faqat o'zbekcha matn "maqsadi tushunarsiz" deb rad
	     etilishi mumkin edi. Shuning uchun har matn "O'zbekcha … /
	     English …" shaklida va NIMA UCHUN kerakligini aniq aytadi. -->
	<key>NFCReaderUsageDescription</key>
	<string>NFC karta va stikerlarni o‘qish hamda profilingiz havolasini o‘z kartangizga yozish uchun kerak. / NFCSTORE uses NFC to read NFC cards and stickers and to write your profile link to your own card.</string>
	<!-- Rasm / video tanlash va suratga olish (image_picker, file_picker).
	     Bu kalitlar bo'lmasa iOS ilovani galereya yoki kamera
	     ochilgan ZAHOTI yopib yuboradi va App Store buni rad etadi. -->
	<!-- Face ID: bu matnsiz iOS Face ID oynasini ochmaydi (local_auth
	     xato qaytaradi) — ilova qulfi faqat PIN bilan qolardi. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Ilova qulfini PIN o‘rniga Face ID bilan ochish uchun kerak. / NFCSTORE uses Face ID to open the app lock instead of typing your PIN.</string>
	<key>NSCameraUsageDescription</key>
	<string>Profil, post, istoriya va Reels uchun surat yoki video olish uchun kerak. / NFCSTORE uses the camera so you can take a photo or record a video for your profile, posts, stories and Reels.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Galereyadan rasm yoki video tanlab, profil, post, istoriya, Reels va biznes katalogiga qo‘yish uchun kerak. / NFCSTORE uses your photo library so you can choose photos or videos for your profile, posts, stories, Reels and business catalog.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Post, istoriya yoki Reels uchun video yozganda ovozni ham yozib olish uchun kerak. / NFCSTORE uses the microphone to record sound when you record a video for a post, story or Reel.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Rasm yoki videoni o‘zingiz Rasmlar (Photos) ilovasiga saqlashni tanlaganingizda kerak. / NFCSTORE needs this only when you choose to save an image or video to your Photos.</string>
	<!-- MUSIQA KUTUBXONASI (iOS "Music" / MPMediaPickerController).
	
	     Profil tahririda "Musiqa qo'shish" iPhone'da ENDI Fayllar
	     (UIDocumentPicker) oynasini ochadi — unga ruxsat kerak emas
	     (`profile_edit_screen.dart`, `FileType.custom`). Lekin
	     file_picker plagini musiqa kutubxonasi kodini (PICKER_AUDIO)
	     baribir ilovaga qo'shib yig'adi: kalit bo'lmasa App Store
	     Connect yuklashda ITMS-90683 ogohlantirishini beradi, kod
	     qachondir `FileType.audio` ga qaytsa esa ilova o'sha zahoti
	     YIQILADI. Shuning uchun kalit ikkala holatda ham turadi. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>Profilingizga qo‘shish uchun qurilmangizdagi qo‘shiqni tanlaganingizda kerak. / NFCSTORE uses your media library only when you choose a song on your device to add to your profile.</string>
	<!-- Ilova shifrlashni faqat standart HTTPS uchun ishlatadi:
	     App Store Connect har yuklashda eksport so'rovini bermasin. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uz.nfcstore.nova</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nfcstore</string>
			</array>
		</dict>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
</dict>
</plist>
