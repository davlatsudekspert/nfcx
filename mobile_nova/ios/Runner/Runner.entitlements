<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TAG — `nfc_manager` iOS'da FAQAT NFCTagReaderSession
	     ishlatadi (SwiftNfcManagerPlugin.swift), u esa aynan shu
	     formatni talab qiladi. Tegdagi NDEF yozuvini o'qish va yozish
	     ham shu sessiya ichida bo'ladi — alohida ruxsat kerak emas.

	     `NDEF` qiymati QO'YILMAYDI: Apple uni taqiqlagan. Fayl
	     avval faqat `NDEF` bilan turgan edi — shunda App Store'ga
	     yuklash ITMS-90778 "NDEF is disallowed" xatosi bilan rad
	     etilardi, telefonda esa sessiya ochilmay NFC umuman
	     ishlamasdi. CI (`nova-ios.yml`) buni qaytib kelishdan
	     qo'riqlaydi. -->
	<!-- UNIVERSAL LINKS — ulashilgan nfcstore.uz/post/..., /u/, /c/,
	     /story/, /nfc/ havolalari iPhone'da saytni emas, ilovani
	     ochsin (Android'dagi App Links bilan bir xil). Sayt tomoni:
	     /.well-known/apple-app-site-association (hosting/worker.js).
	     App ID'da Associated Domains yoqilgan, imzo profili ham uni
	     o'z ichiga oladi (nova-ios-testflight.yml tekshiradi). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:nfcstore.uz</string>
		<string>applinks:www.nfcstore.uz</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
