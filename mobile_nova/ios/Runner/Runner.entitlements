<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NDEF — bizga aynan shu format kerak: teg ichidagi URI
	     yozuvini o'qish va yozish. `TAG` formati (xom APDU)
	     SO'RALMAYDI: u kerak emas va Apple uni alohida
	     asoslashni talab qiladi. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
	</array>
</dict>
</plist>
