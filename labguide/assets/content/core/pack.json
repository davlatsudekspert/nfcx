 "quiz": [
  {
   "id": "dilution-equation",
   "review_state": "pending",
   "source_ids": [],
   "correct_index": 0,
   "prompt": {
    "uz": "Suyultirishda yakuniy konsentratsiya uchun qaysi tenglama ishlatiladi?",
    "ru": "Какое уравнение используется для расчёта разведения?",
    "en": "Which equation is used for a dilution?"
   },
   "basis": {
    "uz": "Miqdoriy konsentratsiya ta’rifi: c = n / V. Faqat erituvchi qo‘shilsa, n o‘zgarmaydi.",
    "ru": "Определение молярной концентрации: c = n / V. При добавлении только растворителя n не меняется.",
    "en": "Definition of amount concentration: c = n / V. Adding only solvent leaves n unchanged."
   },
   "options": [
    {
     "text": {
      "uz": "C₁V₁ = C₂V₂",
      "ru": "C₁V₁ = C₂V₂",
      "en": "C₁V₁ = C₂V₂"
     },
     "explanation": {
      "uz": "To‘g‘ri: erituvchi qo‘shilganda modda miqdori saqlanadi — oldin n = C₁V₁, keyin n = C₂V₂.",
      "ru": "Верно: при добавлении растворителя количество вещества сохраняется — до n = C₁V₁, после n = C₂V₂.",
      "en": "Correct: adding solvent conserves the amount of solute — n = C₁V₁ before and n = C₂V₂ after."
     }
    },
    {
     "text": {
      "uz": "C₁ + V₁ = C₂ + V₂",
      "ru": "C₁ + V₁ = C₂ + V₂",
      "en": "C₁ + V₁ = C₂ + V₂"
     },
     "explanation": {
      "uz": "Konsentratsiya va hajm turli birlikda — ularni qo‘shib bo‘lmaydi. Saqlanadigan kattalik n = C·V.",
      "ru": "Концентрацию и объём нельзя складывать — у них разные единицы. Сохраняется n = C·V.",
      "en": "Concentration and volume have different units and can't be added. The conserved quantity is n = C·V."
     }
    },
    {
     "text": {
      "uz": "C₁V₂ = C₂ / V₁",
      "ru": "C₁V₂ = C₂ / V₁",
      "en": "C₁V₂ = C₂ / V₁"
     },
     "explanation": {
      "uz": "O‘lchamlar mos emas: chap tomonda miqdor, o‘ng tomonda esa hajmga bo‘lingan konsentratsiya.",
      "ru": "Размерности не совпадают: слева количество вещества, справа концентрация, делённая на объём.",
      "en": "The dimensions don't match: the left side is an amount, the right side is concentration divided by volume."
     }
    }
   ]
  },
  {
   "id": "unit-factor",
   "review_state": "pending",
   "source_ids": [],
   "correct_index": 1,
   "prompt": {
    "uz": "Boshqa moddaning mg/dL → mmol/L koeffitsiyentini ishlatish mumkinmi?",
    "ru": "Можно ли использовать коэффициент mg/dL → mmol/L другого вещества?",
    "en": "Can another analyte’s mg/dL → mmol/L factor be reused?"
   },
   "basis": {
    "uz": "Molyar konsentratsiya = massa konsentratsiyasi / molyar massa.",
    "ru": "Молярная концентрация = массовая концентрация / молярная масса.",
    "en": "Molar concentration = mass concentration / molar mass."
   },
   "options": [
    {
     "text": {
      "uz": "Har doim",
      "ru": "Всегда",
      "en": "Always"
     },
     "explanation": {
      "uz": "Molyar massalar farq qiladi, demak koeffitsiyent ham: glyukoza ≈ 18,0 mg/dL har 1 mmol/L ga, kreatinin ≈ 11,3 mg/dL.",
      "ru": "Молярные массы различаются, значит и коэффициенты: глюкоза ≈ 18,0 mg/dL на 1 mmol/L, креатинин ≈ 11,3 mg/dL.",
      "en": "Molar masses differ, so the factors differ: glucose ≈ 18.0 mg/dL per 1 mmol/L, creatinine ≈ 11.3 mg/dL."
     }
    },
    {
     "text": {
      "uz": "Yo‘q, moddaning molyar massasi kerak",
      "ru": "Нет, нужна молярная масса вещества",
      "en": "No, the analyte’s molar mass is needed"
     },
     "explanation": {
      "uz": "To‘g‘ri: mmol/L = (mg/dL × 10) / molyar massa (g/mol). Har bir modda o‘z molyar massasini talab qiladi.",
      "ru": "Верно: mmol/L = (mg/dL × 10) / молярная масса (г/моль). Для каждого вещества нужна своя молярная масса.",
      "en": "Correct: mmol/L = (mg/dL × 10) / molar mass (g/mol). Each substance needs its own molar mass."
     }
    },
    {
