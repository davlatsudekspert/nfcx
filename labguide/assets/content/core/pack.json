 "analytes": [
  {
   "id": "glucose-plasma-fasting",
   "status": "draft",
   "content_state": "sourced_sample",
   "names": {
    "uz": "Och qoringa plazma glyukozasi",
    "ru": "Глюкоза плазмы натощак",
    "en": "Fasting plasma glucose"
   },
   "tagline": {
    "uz": "Natija → kontekst → tushuncha",
    "ru": "Результат → контекст → понимание",
    "en": "Result → context → understanding"
   },
   "synonyms": [
    "FPG",
    "glucose",
    "glyukoza",
    "глюкоза",
    "qand",
    "сахар крови",
    "blood sugar",
    "ГПН"
   ],
   "group": "carbohydrate",
   "specimen": {
    "uz": "Plazma",
    "ru": "Плазма",
    "en": "Plasma"
   },
   "population": {
    "uz": "Kattalar, homilador bo‘lmagan",
    "ru": "Взрослые, небеременные",
    "en": "Adults, not pregnant"
   },
   "method": null,
   "units": [
    "mg/dL",
    "mmol/L"
   ],
   "sections": [
    "purpose",
    "physiology",
    "high_result",
    "low_result",
    "preanalytics",
    "interference",
    "related_tests",
    "limitations"
   ],
   "claims": [
    {
     "section": "purpose",
     "source_ids": [
      "medline-glucose"
     ],
     "locator": "What is it used for?",
     "text": {
      "uz": "Prediabet va diabetni skrining qilish, glyukoza yuqori yoki pastligini ko‘rsatuvchi belgilar sababini aniqlash va glyukozaga ta’sir qiluvchi ayrim uzoq muddatli dorilarning nojo‘ya ta’sirini kuzatish uchun.",
      "ru": "Скрининг предиабета и диабета, выяснение причины симптомов повышенной или пониженной глюкозы и контроль побочных эффектов некоторых длительно принимаемых лекарств, влияющих на глюкозу.",
      "en": "Screening for prediabetes and diabetes, finding the cause of symptoms of high or low glucose, and monitoring side effects of some long-term medicines that affect glucose."
     }
    },
    {
     "section": "high_result",
     "source_ids": [
      "medline-glucose"
     ],
     "locator": "What do the results mean?",
     "text": {
      "uz": "Eng ko‘p uchraydigan sabablar — prediabet va diabet. Boshqa mumkin bo‘lgan sabablar: qalqonsimon bez faolligining oshishi (gipertireoz), oshqozonosti bezi muammolari (jumladan pankreatit), jarrohlik, juda og‘ir kasallik yoki jarohat stressi, buyrak usti bezi muammolari va ayrim dorilar.",
      "ru": "Самые частые причины — предиабет и диабет. Другие возможные причины: повышенная функция щитовидной железы (гипертиреоз), болезни поджелудочной железы (включая панкреатит), стресс при операции, очень тяжёлой болезни или травме, болезни надпочечников и некоторые лекарства.",
      "en": "Prediabetes and diabetes are the most common causes. Other possible causes include an overactive thyroid gland (hyperthyroidism), pancreatic problems including pancreatitis, stress from surgery, very serious illness or trauma, adrenal gland problems and certain medicines."
     }
    },
    {
     "section": "low_result",
     "source_ids": [
      "medline-glucose"
     ],
     "locator": "What do the results mean?",
     "text": {
      "uz": "Diabeti bor odamlarda: ayrim diabet dorilari va glyukozani pasaytiruvchi boshqa dorilar, yetarli ovqatlanmaslik (ayniqsa diabet dorisidan keyin), odatdagidan ko‘proq jismoniy faollik. Diabet bo‘lmasa, past glyukoza kam uchraydi; mumkin bo‘lgan sabablar: jigar yoki buyrak kasalligi, buyrak usti bezi yetishmovchiligi, ayrim gipofiz kasalliklari, qalqonsimon bez faolligining pasayishi (gipotireoz), to‘yib ovqatlanmaslik, ayrim dorilar va alkogolga qaramlik.",
      "ru": "При диабете: некоторые лекарства от диабета и другие препараты, снижающие глюкозу, недостаточное питание (особенно после приёма лекарства от диабета), физическая нагрузка больше обычной. Без диабета низкая глюкоза встречается редко; возможные причины: болезни печени или почек, недостаточность надпочечников, некоторые заболевания гипофиза, сниженная функция щитовидной железы (гипотиреоз), истощение, некоторые лекарства и расстройство, связанное с употреблением алкоголя.",
      "en": "With diabetes: some diabetes medicines and other glucose-lowering medicines, not eating enough (especially after taking diabetes medicine) and more physical activity than usual. Without diabetes, low glucose is uncommon; possible causes include liver or kidney disease, underactive adrenal glands, some pituitary disorders, an underactive thyroid gland (hypothyroidism), malnutrition, certain medicines and alcohol use disorder."
     }
    },
    {
     "section": "limitations",
     "source_ids": [
      "medline-glucose"
     ],
     "locator": "What do the results mean?",
     "text": {
      "uz": "Natijaning ma’nosi qaysi test qilingani, boshqa tahlillar natijalari va kasallik tarixiga bog‘liq.",
      "ru": "Значение результата зависит от вида теста, результатов других анализов и анамнеза.",
      "en": "What a result means depends on which test was done, other test results and the medical history."
     }
    }
   ],
   "notes": {
    "preanalytics": {
     "uz": "Probirka, saqlash va ajratish shartlari aniq reagent IFU va mahalliy SOP ga bog‘lanadi. Bu namunada universal vaqt, harorat yoki apparat parametri berilmagan.",
     "ru": "Пробирка, хранение и отделение образца привязываются к конкретной IFU реагента и локальной SOP. Универсальные время, температура и параметры прибора здесь не задаются.",
     "en": "Tube, storage and separation conditions are tied to the exact reagent IFU and local SOP. No universal times, temperatures or instrument settings are given here."
    }
   },
