# Railway PostgreSQL ulanishi.
# Railway'da: Variables -> New Variable -> Add Reference Variable -> DATABASE_URL
# Lokal test uchun (PostgreSQL o'rnatilgan bo'lsa):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/belgi

# Server porti (ixtiyoriy, standart: 3001)
# PORT=3001

# Admin akkaunt — server har ishga tushganda avtomatik yaratiladi/
# sinxronlanadi (bo'lmasa yaratadi, paroli mos kelmasa yangilaydi).
# Railway'da Variables bo'limiga qo'shing.
# ADMIN_EMAIL=admin@nfcstore.uz
# ADMIN_PASSWORD=parolingiz
