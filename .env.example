# Railway PostgreSQL ulanishi.
# Railway'da: Variables -> New Variable -> Add Reference Variable -> DATABASE_URL
# Lokal test uchun (PostgreSQL o'rnatilgan bo'lsa):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/belgi

# Server porti (ixtiyoriy, standart: 3001)
# PORT=3001

# Admin akkaunt — server startda avtomatik yaratiladi/parol sinxronlanadi.
# ADMIN_EMAIL=admin@nfcstore.uz
# ADMIN_PASSWORD=super_maxfiy_parol

# Telegram bot (BotFather'dan olingan token).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# ADMIN_CHAT_ID=123456789          # adminning raqamli Telegram ID'si
# STORE_CARD=8600 1234 5678 9012   # qo'lda to'lov uchun karta/hamyon
# ADMIN_CONTACT=@username          # mijozlar uchun admin kontakti

# Paynet avtomatik to'lov (ixtiyoriy) — partner.paynet.uz kabinetidan:
# PAYNET_MERCHANT_ID=...
# PAYNET_WEBHOOK_LOGIN=...
# PAYNET_WEBHOOK_PASSWORD=...
# Kabinetda Callback URL: https://<domen>/api/pay/paynet/webhook

# Payme hamyon to'ldirish (ixtiyoriy) — business.payme.uz kabinetidan:
# PAYME_MERCHANT_ID=...   (Cassa ID)
# PAYME_KEY=...            (test yoki ishlab chiqarish kaliti)
# Kabinetda Callback URL: https://<domen>/api/pay/payme

# Auksion komissiyasi (foizda, ixtiyoriy, standart: 5)
# AUCTION_COMMISSION_PCT=5

# Premium profilga obuna bo'lishda platforma oladigan komissiya (foizda,
# ixtiyoriy, standart: 5) — qolgani premium profil egasiga tushadi.
# PREMIUM_FOLLOW_COMMISSION_PCT=5

# Admin panel (/admin) — ODDIY foydalanuvchi akkauntidan ALOHIDA.
# XAVFSIZLIK: bu qiymatlarni HECH QACHON kodga yozmang, faqat Railway
# Variables'ga qo'shing.
# ADMIN_PANEL_PHONE=+998990118277
# ADMIN_PANEL_PASSWORD=...
