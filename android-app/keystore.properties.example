# Release signing template — android/docs/16-PHASE13-RELEASE-REPORT.md.
#
# A real keystore is NEVER generated by this project without the user's
# explicit go-ahead (brief section 20). To sign a real release build:
#
#   1. Generate a real keystore yourself (once, offline, kept secret):
#        keytool -genkeypair -v -storetype PKCS12 \
#          -keystore nfcstore-release.keystore \
#          -alias nfcstore -keyalg RSA -keysize 2048 -validity 10000
#
#   2. Copy this file to `keystore.properties` at the PROJECT ROOT
#      (sibling to app.json — NOT inside the generated `android/` folder,
#      which `expo prebuild --clean` deletes and regenerates from scratch
#      every time) and fill in the real values.
#
#   3. Put the actual .keystore/.jks file somewhere OUTSIDE version control
#      too, and point storeFile at it, relative to android/app/ (e.g.
#      "../../nfcstore-release.keystore" if it sits next to this file).
#
#   4. Re-run `npx expo prebuild -p android` — plugins/withReleaseSigning.js
#      detects this file and wires the signingConfig automatically.
#
# NEVER commit a real keystore.properties or a real .keystore/.jks file.

storeFile=../../nfcstore-release.keystore
storePassword=REPLACE_ME
keyAlias=nfcstore
keyPassword=REPLACE_ME
