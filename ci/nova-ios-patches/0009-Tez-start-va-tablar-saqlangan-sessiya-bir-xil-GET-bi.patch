+  }
+
+  void _warmUp() {
+    if (_warm || !mounted) return;
+    _timer?.cancel();
+    _net?.removeListener(_onNet);
+    _net = null;
+    setState(() => _warm = true);
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    _net?.removeListener(_onNet);
+    super.dispose();
+  }
