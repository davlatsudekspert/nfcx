+  Future<Result<T>> get<T>(String path, {Map<String, dynamic>? query}) {
+    final q = _clean(query);
+    final key = '$T|${_token ?? ''}|$path?'
+        '${q == null ? '' : (q.keys.toList()..sort()).map((k) => '$k=${q[k]}').join('&')}';
+    final pending = _inflight[key];
