diff --git a/mobile_nova/lib/l10n/gen/app_localizations.dart b/mobile_nova/lib/l10n/gen/app_localizations.dart
index 82c90cf..3577046 100644
--- a/mobile_nova/lib/l10n/gen/app_localizations.dart
+++ b/mobile_nova/lib/l10n/gen/app_localizations.dart
@@ -6434,6 +6434,18 @@ abstract class L {
   /// In uz, this message translates to:
