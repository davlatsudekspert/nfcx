+      _web.setNavigationDelegate(NavigationDelegate(
+        onPageFinished: (_) =>
+            _web.runJavaScript(MusicEmbed.yandexBridgeJs).catchError((_) {}),
+      ));
+    }
     widget.controller
       .._web = _web
       .._kind = widget.source.kind;
