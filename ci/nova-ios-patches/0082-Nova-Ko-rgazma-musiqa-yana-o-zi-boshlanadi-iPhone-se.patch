+Future<void> _frames(WidgetTester tester, [int n = 30]) async {
+  for (var i = 0; i < n; i++) {
+    await tester.pump(const Duration(milliseconds: 50));
+    // `VideoPlayerController.dispose` haqiqiy asinxron ishni kutadi.
+    if (i % 5 == 0) {
