From 3ece6a5cca60ccd573f521d976bf7062614567c4 Mon Sep 17 00:00:00 2001
From: NFCSTORE CI <ci@nfcstore.uz>
Date: Sun, 4 Oct 2026 11:47:51 +0000
Subject: [PATCH] Ilova nfcstore:// sxemasi va katalog tovarlarida ko'rishlar
 soni

- Android intent-filter + iOS CFBundleURLTypes: saytdagi "Ilovada ochish"
  ilovaning o'zini ochadi (nfcstore://nfcstore.uz/post/<id>)
- CatalogProduct/CatalogItem.views; katalog kartasi va tovar sahifasida
  ko'z belgisi + son

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X3fizJ3F3nvfvUZqdZamcq
---
 .../android/app/src/main/AndroidManifest.xml  | 10 +++++
 mobile_nova/ios/Runner/Info.plist             | 13 ++++++
 mobile_nova/lib/data/models/models.dart       | 12 ++++++
 .../lib/features/discover/catalog_view.dart   | 40 ++++++++++++++++++-
 mobile_nova/test/content_views_test.dart      | 13 ++++++
 mobile_nova/test/routes_test.dart             | 18 +++++++++
 6 files changed, 105 insertions(+), 1 deletion(-)

diff --git a/mobile_nova/android/app/src/main/AndroidManifest.xml b/mobile_nova/android/app/src/main/AndroidManifest.xml
index 5e4edbc..5fcbb86 100644
--- a/mobile_nova/android/app/src/main/AndroidManifest.xml
+++ b/mobile_nova/android/app/src/main/AndroidManifest.xml
@@ -72,6 +72,16 @@
                 <data android:scheme="https" android:host="nfcstore.uz" android:pathPrefix="/story/"/>
                 <data android:scheme="https" android:host="nfcstore.uz" android:pathPrefix="/nfc/"/>
             </intent-filter>
+            <!-- ILOVA SXEMASI — nfcstore://nfcstore.uz/post/<id>?code=...
+                 Saytdagi "Ilovada ochish" tugmasi (intent://) shu orqali
+                 ilovaning o'zini ochadi. Telegram/Instagram ichki brauzeri
+                 App Links'ni chetlab o'tadi — sxema esa ishlaydi. -->
+            <intent-filter>
+                <action android:name="android.intent.action.VIEW"/>
+                <category android:name="android.intent.category.DEFAULT"/>
+                <category android:name="android.intent.category.BROWSABLE"/>
+                <data android:scheme="nfcstore" android:host="nfcstore.uz"/>
+            </intent-filter>
             <intent-filter>
                 <action android:name="android.nfc.action.NDEF_DISCOVERED"/>
                 <category android:name="android.intent.category.DEFAULT"/>
diff --git a/mobile_nova/ios/Runner/Info.plist b/mobile_nova/ios/Runner/Info.plist
index a59a604..e8413cd 100644
--- a/mobile_nova/ios/Runner/Info.plist
+++ b/mobile_nova/ios/Runner/Info.plist
@@ -79,5 +79,18 @@
 	<true/>
 	<key>UIApplicationSupportsIndirectInputEvents</key>
 	<true/>
+	<key>CFBundleURLTypes</key>
+	<array>
+		<dict>
+			<key>CFBundleURLName</key>
+			<string>uz.nfcstore.nova</string>
+			<key>CFBundleURLSchemes</key>
+			<array>
+				<string>nfcstore</string>
+			</array>
+		</dict>
+	</array>
+	<key>FlutterDeepLinkingEnabled</key>
+	<true/>
 </dict>
 </plist>
