   final int id;
 
   /// Serverdagi ASL identifikator — satr ko'rinishida.
@@ -1118,6 +1129,7 @@ class CatalogItem {
       // Server qoidasi bilan bir xil: bayroq yoki narx 0.
       priceOnRequest: _b(j['priceOnRequest']) || price <= 0,
       priceSoon: _b(j['priceSoon']),
