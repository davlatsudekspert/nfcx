+    l.storeBuyOnSiteBizName,
+    l.bizPlanStoreNotice,
+    kSiteHost,
+  ]) {
+    expect(find.text(s), findsNothing, reason: s);
+  }
+  expect(find.textContaining('sayt'), findsNothing);
+}
 
