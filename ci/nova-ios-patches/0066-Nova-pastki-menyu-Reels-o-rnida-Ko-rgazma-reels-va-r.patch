+        },
+      ),
+      GoRoute(
+        path: Routes.reelCreate,
+        builder: (_, s) {
+          pushed.add(s.uri.path);
+          return const Scaffold(body: Text('REEL'));
+        },
+      ),
+    ]);
+    await tester.pumpWidget(UncontrolledProviderScope(
