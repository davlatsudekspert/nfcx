+/// Tozalash oynasidagi qisqa ko'rinish — tegdagi narsa (90 belgigacha).
+String erasePreview(String raw) {
+  final v = raw.trim().replaceAll(RegExp(r'\s+'), ' ');
+  return v.length > 90 ? '${v.substring(0, 90)}…' : v;
