+
+/// Asosiy (to'ldirilgan) tugma nima qiladi.
+enum ForeignPrimary {
+  /// NFC ID bor — yozish ekrani.
+  writeProfile,
+
+  /// Kirgan, lekin NFC ID hali yo'q — avval ID, keyin yozish.
+  getId,
+
