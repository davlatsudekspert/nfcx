+  @override
+  Future<Result<({User user, List<NfcId> ids})>> restore() async =>
+      Ok((user: user, ids: testIds));
+
+  @override
+  Future<Result<({User user, List<NfcId> ids})>> me() async {
+    _log.add('me');
+    return restore();
+  }
