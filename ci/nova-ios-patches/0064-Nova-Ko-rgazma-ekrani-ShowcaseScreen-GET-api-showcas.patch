+              duration: Motion.fast,
+              margin: const EdgeInsets.symmetric(horizontal: 3),
+              width: i == index ? 16 : 6,
+              height: 6,
+              decoration: BoxDecoration(
+                color: color.withValues(alpha: i == index ? .95 : .5),
