+    await _pump(tester, v);
+    final zone = find.byKey(const ValueKey('reel-scrub'));
+    expect(zone, findsOneWidget);
+    final r = tester.getRect(zone);
+    await tester.tapAt(Offset(r.left + r.width * .5, r.center.dy));
