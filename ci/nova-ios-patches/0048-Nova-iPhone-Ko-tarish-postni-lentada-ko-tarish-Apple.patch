+IapPurchase _tx(String id, {String jws = 'JWS-B', String txId = '3000000777'}) =>
+    IapPurchase(
+      productId: id,
+      status: IapPurchaseStatus.purchased,
+      purchaseId: txId,
+      signedTransaction: jws,
+      needsCompletion: true,
+    );
