+/// Ko'tarish vaqtini ko'rsatish — mahalliy, `kk.oo.yyyy ss:dd`.
+String boostTime(DateTime d) {
+  final x = d.toLocal();
+  String two(int n) => n.toString().padLeft(2, '0');
+  return '${two(x.day)}.${two(x.month)}.${x.year} ${two(x.hour)}:${two(x.minute)}';
+}
