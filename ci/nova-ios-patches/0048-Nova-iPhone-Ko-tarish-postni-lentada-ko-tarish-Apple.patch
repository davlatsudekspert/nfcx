+  BoostPackage(productId: _p6, days: 6),
+];
+const _on = IapConfig(boostEnabled: true, boostProducts: _pkgs);
+const _tok = '6f1c2a7e-0d3b-4e4f-9a51-2b8c7d6e5f40';
