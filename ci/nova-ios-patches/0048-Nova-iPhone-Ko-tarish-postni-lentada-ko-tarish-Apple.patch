+/// Oqim hodisalari va asinxron zanjir tugashi.
+Future<void> _drain(WidgetTester tester) async {
+  for (var i = 0; i < 6; i++) {
+    await tester.pump(const Duration(milliseconds: 10));
+  }
+}
