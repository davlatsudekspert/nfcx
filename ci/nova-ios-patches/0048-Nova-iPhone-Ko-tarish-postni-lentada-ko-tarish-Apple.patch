+    _log.add('token');
+    return const Ok(_tok);
+  }
+
+  @override
+  Future<Result<IapVerifyResult>> verify(String signedTransaction) async {
+    _log.add('premium-verify:$signedTransaction');
+    return const Ok(IapVerifyResult(premium: true));
+  }
+
+  @override
