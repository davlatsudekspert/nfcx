+              value: a.contentViews,
+              icon: Icons.visibility_outlined,
+              tone: t.accentB),
+          _Stat(
+              key: const ValueKey('an-profile-views'),
+              label: l.analyticsProfileViews,
+              value: a.profileViews,
+              icon: Icons.person_search_outlined,
+              tone: t.accentC),
+        ),
+        pair(
+          _Stat(
