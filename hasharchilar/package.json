{
  "name": "hasharchilar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "mkdir -p dist && wrangler dev --port 8787",
    "build": "vite build",
    "db:local": "wrangler d1 execute hasharchilar --local --file=schema.sql && wrangler d1 execute hasharchilar --local --file=seed.sql",
    "db:remote": "wrangler d1 execute hasharchilar --remote --file=schema.sql",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
